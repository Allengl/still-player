{
    "expo": {
        "name": "Still",
        "slug": "still",
        "version": "1.0.5",
        "orientation": "portrait",
        "icon": "./assets/logo-still.png",
        "userInterfaceStyle": "dark",
        "newArchEnabled": true,
        "scheme": "still",
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#000000"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.still.player"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/logo-still.png",
                "backgroundColor": "#000000"
            },
            "edgeToEdgeEnabled": true,
            "package": "com.still.player"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            [
                "expo-audio",
                {
                    "enableBackgroundPlayback": true
                }
            ],
            "expo-router",
            "expo-document-picker"
        ]
    }
}
